# ───────────── 公开配置（会出现在前端） ─────────────
NEXT_PUBLIC_SITE_NAME=BFATE
# 56 = BSC 主网，97 = BSC 测试网
NEXT_PUBLIC_CHAIN_ID=56
# $BFATE 合约地址；不填就用代码里的主网合约 0xce62…7777（2026-10-09 发射），填了覆盖
NEXT_PUBLIC_BFATE_TOKEN=
NEXT_PUBLIC_BFATE_DECIMALS=18
NEXT_PUBLIC_BFATE_SYMBOL=BFATE
# 官方 X（Twitter）账号，顶栏 / 页脚 / 首页都会显示
NEXT_PUBLIC_X_URL=https://x.com/BinanceFATE
# 每次解读价格（整数枚）
NEXT_PUBLIC_PRICE_PER_READING=1000
# 付费去向；默认黑洞销毁。改成项目钱包地址即为收款
NEXT_PUBLIC_PAY_TO=0x000000000000000000000000000000000000dEaD
# 每日免费次数：币安 Web3 钱包 / 其他钱包
NEXT_PUBLIC_FREE_DAILY_BINANCE=5
NEXT_PUBLIC_FREE_DAILY_OTHER=0
# 每日零点按这个时区换日
NEXT_PUBLIC_TIME_ZONE=Asia/Shanghai

# ───────────── 服务端密钥（只在服务端读取） ─────────────
# 会话签名密钥，至少 32 个字符的随机串（线上必填）
SESSION_SECRET=
# BSC 节点：验签与核对付款用；可换成自己的付费节点
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# 付款需要的确认块数
PAY_CONFIRMATIONS=2
# 同一 IP 每天最多可用的免费次数（防批量换地址刷免费）
FREE_DAILY_PER_IP=30

# 存储：Upstash Redis（Vercel → Storage → Upstash 一键接入会自动注入 KV_REST_API_URL / KV_REST_API_TOKEN）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI 细说（可选）：不填则只展示规则文案
ANTHROPIC_API_KEY=
# 默认 claude-opus-5-5
ANTHROPIC_MODEL=
